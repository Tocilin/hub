# Copy to .env.local and fill in. Never commit real values.

# --- Supabase (public; safe to expose to the browser) ---
# Local: printed by `supabase start`. Production: Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Server-only ---
# The single email address allowed to use HUB. Checked server-side on every request.
HUB_APPROVED_EMAIL=you@example.com
